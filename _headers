# Cloudflare static assets: response headers.
# Font data and the vendored libraries never change under the same file name, so browsers may keep them.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
# The font list changes when fonts are added, and the page and app change with every release: always revalidate.
/fonts/manifest.js
  ! Cache-Control
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
